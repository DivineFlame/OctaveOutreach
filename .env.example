# ── Database ──────────────────────────────────────────────
# docker-compose builds DATABASE_URL from these three values.
POSTGRES_DB=outreach
POSTGRES_USER=outreach
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Set DATABASE_URL directly when running `npm run dev` against your own Postgres,
# or when pointing a Dokploy app at a managed database instead of the bundled one.
# DATABASE_URL=postgresql://outreach:password@localhost:5432/outreach
# DATABASE_SSL=false

# ── First owner account ───────────────────────────────────
# Created on first boot by docker-entrypoint.sh. Password must be 12+ characters.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-app-password
APP_DISPLAY_NAME=Workspace Owner
WORKSPACE_NAME=Octave

# ── Drafting model ────────────────────────────────────────
# Optional. With no key the app writes every draft from its built-in templates.
# Precedence: LLM_PROVIDER override -> ANTHROPIC_API_KEY -> OPENAI_API_KEY -> templates.
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Local docker-compose.local.yml only ───────────────────
APP_PORT=3000
POSTGRES_PORT=5432
